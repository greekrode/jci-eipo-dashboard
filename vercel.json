{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!assets/|logo\\.png|robots\\.txt|sitemap\\.xml|server/).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "bun run build",
  "installCommand": "bun install",
  "outputDirectory": "dist",
  "framework": "vite"
}
